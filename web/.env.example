# URL of the Render backend (no trailing slash). Leave empty in dev to use the Vite proxy.
VITE_API_URL=https://jobpilot-xxxx.onrender.com

# Optional: the backend's APP_TOKEN, so visitors never type it.
# It ends up in the public JavaScript, so anyone with the site URL can use your app (rate limits still apply).
VITE_APP_TOKEN=
