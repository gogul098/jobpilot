# Required
GROQ_API_KEY=gsk_...
APP_TOKEN=pick-a-long-random-string     # the page asks for this; keeps strangers out

# Models tried in order. Each has its own rate-limit budget on Groq; check console.groq.com/docs/models
GROQ_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b,qwen/qwen3-32b,meta-llama/llama-4-scout-17b-16e-instruct,llama-3.1-8b-instant

# Optional last-resort provider (free key at aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash

# Tuning
WORKER_CONCURRENCY=4
LLM_CACHE_TTL=3600
JOB_TTL=3600                            # temp files deleted 1 hour after last use
COMPILE_TIMEOUT=25
# LLM_MOCK=1                            # run fully offline with a fake model

# Phase 2 (optional)
JSEARCH_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_NAME=
EMAIL_DAILY_LIMIT=15
